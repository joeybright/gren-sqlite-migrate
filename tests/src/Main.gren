{-|-}
singleMigrationTests : FileSystem.Permission -> Sqlite.Migrate.Permissions -> Test.Runner.Effectful.Test
singleMigrationTests fileSystemPermission permissions =
    let
        statements =
            [ "CREATE TABLE foo (id INTEGER)" 
            ]

        additionalStatements =
            [ "CREATE TABLE IF NOT EXISTS foo (id INTEGER)"
            , "CREATE TABLE IF NOT EXISTS bar (first TEXT, second TEXT, third TEXT)"
            ]

        migrations =
            [ { name = "v1"
              , statements = statements
              }
            ]

        additionalMigration =
            Array.append
                [ { name = "v2"
                  , statements = additionalStatements
                  }
                ]
                migrations

        getAllFromFoo db =
            Sqlite.getAll db 
                { query = "SELECT * FROM foo"
                , parameters = []
                , rowDecoder =
                    Sqlite.Decode.Row.column "id" Sqlite.Decode.int (\_ ->
                        Sqlite.Decode.Row.succeed {}
                    )
                }
    in
    describe "Tests with a single migration in the migrations array"
        [ await "Open in-memory database"
            (Sqlite.open fileSystemPermission Sqlite.defaultOptions (Sqlite.File (FileSystem.Path.fromPosixString "./test.sqlite")))
                (\db ->
                    await "Apply single migration"
                        (Sqlite.Migrate.migrate db permissions additionalMigration)
                            (\_ ->
                                describe "Tests after applying the migration"
                                    [ test "Migration applies successfully"
                                        (\_ -> Expect.pass)
                                    , await "Get data from the created table"
                                        (getAllFromFoo db)
                                        (\data ->
                                            test "Expect empty table"
                                                (\_ ->
                                                    Expect.equal data []
                                                )
                                        )
                                    , await "Apply single migration again"
                                        (Sqlite.Migrate.migrate db permissions additionalMigration)
                                        (\_ ->
                                            describe "Tests after the migration was applied again" 
                                                [ test "Migration applies successfully"
                                                    (\_ -> Expect.pass)
                                                , await "Get data from the created table"
                                                    (getAllFromFoo db)
                                                    (\data ->
                                                        describe "Tests after getting data from created table"
                                                            [ test "Expect empty table"
                                                                (\_ ->
                                                                    Expect.equal data []
                                                                )
                                                            , await "Apply additional migrations"
                                                                (Sqlite.Migrate.migrate db permissions additionalMigration)
                                                                (\_ ->
                                                                    test "Migration succeeds"
                                                                        (\_ -> Expect.pass)
                                                                )
                                                            ]
                                                    )
                                                , await "Get migrations from the migrations table"
                                                    (Sqlite.getAll db getAllMigrationsQuery)
                                                    (\data ->
                                                        test "Succeeds"
                                                            (\_ -> Expect.pass)
                                                    )
                                                ]
                                        )
                                    ]
                            )
                )
        ]


{-|-}
sqliteErrorTests : FileSystem.Permission -> Sqlite.Migrate.Permissions -> Test.Runner.Effectful.Test
sqliteErrorTests fileSystemPermission permissions =
    let
        -- First migration is good, but second has a typo. Expected that the 
        -- migration errors and does not commit changes from the first commit.
        migrations =
            [ { name = "first", statements = [ "CREATE TABLE IF NOT EXISTS test (id TEXT)" ] }
            , { name = "second", statements = [ "CREATE TABEL IF NOT EXISTS test2 (id TEXT)" ] }
            ]
    in
    await "Open database for `sqliteErrorTests`"
        (Sqlite.open fileSystemPermission Sqlite.defaultOptions Sqlite.Memory)
            (\db ->
                awaitError "Migrations with invalid SQL"
                    (Sqlite.Migrate.migrate db permissions migrations)
                    (\err ->
                        describe "Tests after error from invalid SQL in migration"
                            [ when err is
                                Sqlite.Migrate.SqliteError (Sqlite.Error string) ->
                                    test "Produces the correct error with expected error text" 
                                        (\_ -> 
                                            Expect.equal True (String.contains "TABEL" string)
                                        )

                                _ ->
                                    test "Does not produce the expected error" 
                                        (\_ -> Expect.fail "")
                            , awaitError
                                "Try to get data from the table created in the migration with valid SQL"
                                (Sqlite.getAll db
                                    { query = "SELECT * FROM test"
                                    , parameters = []
                                    , rowDecoder =
                                        Sqlite.Decode.Row.column "id" Sqlite.Decode.int (\_ ->
                                            Sqlite.Decode.Row.succeed {}
                                        )
                                    }
                                )
                                (\err_ ->
                                    when err_ is
                                        Sqlite.Error string ->
                                            test "The missing table name is in the error message" 
                                                (\_ -> Expect.equal True (String.contains "test" string)
                                                )
                                        
                                        _ ->
                                            test "Unexpected error"
                                                (\_ -> 
                                                    Expect.fail 
                                                        "The missing table is not in the error message where it should be"
                                                )
                                )
                            ]
                    )
        )


